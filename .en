# Comma-separated key pool (at least 2). Key ids become key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key

# Any LiteLLM model name that matches your keys, e.g. gemini/gemini-2.5-flash, gpt-4o-mini, groq/llama-3.3-70b-versatile
LLM_MODEL=gemini/gemini-2.5-flash

# SQLite location. In Docker this is the /data volume.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins (your deployed frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000

# Enables the X-Simulate-Failure test header. Must be true on the deployed backend for the assignment.
ENABLE_FAILURE_SIMULATION=true

# --- optional ---
CACHE_TYPE=local            # local (in-memory) or disk (stored under CACHE_DIR)
CACHE_TTL_SECONDS=3600
KEY_COOLDOWN_SECONDS=30     # a key that just failed is tried last for this long (0 disables)
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=40     # only the latest N stored messages are sent to the model
DEFAULT_SYSTEM_PROMPT="You are a helpful, concise assistant. Answer clearly and keep earlier messages in this conversation in mind."
ENABLE_DOCS=false

# Docker only: the backend URL the BROWSER should call (frontend container reads this at start)
PUBLIC_API_URL=http://localhost:8000
